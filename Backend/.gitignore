## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.usercode
*.resharper
*.ide
*.vscode

# Build results
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
[Tt]emp/
[Tt]mp/

# Project files
*.csproj.user
*.vcxproj.user
*.sln.GhostDoc.xml
*.psess
*.vsp
*.safariextension
*.webtest
*.cache
*.out
*.log
*.pfx
*.snk
*.MasterPage.cs
*.MasterPage.designer.cs
*.aspx.cs
*.aspx.designer.cs
*.config
*.dll
*.exe
*.pdb
*.lib
*.ncb
*.opensdf
*.sdf
*.cache
*.aps
*.manifest
*.publishproj
*.mix
*.pack
*.swp
*.bak
*.old
*.obj
*.lib
*.exp
*.bin
*.ipa
*.app
*.dSYM
*.xcarchive

# Packages
# ignore packages that are not supported by NuGet
# (i.e. those created by the old project system)
**/packages/*

# Windows details
Thumbs.db
Desktop.ini

# Miscellaneous
*.pid
*.log
*.scc

# Visual Studio 2017+
.vs/
!**/.vs/*.untracked
!**/.vs/*.untracked/**

# End of R# stopping here

# Azure Functions
local.settings.json

# Node modules
node_modules/

*.idea