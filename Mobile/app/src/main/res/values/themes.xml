<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Базовая тема для всего приложения -->
    <style name="Theme.DrawMap" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- === ЦВЕТОВАЯ СХЕМА === -->
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/theme2</item>
        <item name="colorOnPrimary">@color/theme1</item>
        <item name="colorSecondary">@color/theme1</item>
        <item name="colorSecondaryVariant">@color/theme1</item>
        <item name="colorOnSecondary">@color/theme2</item>

        <!-- Фон и текст по умолчанию -->
        <item name="android:colorBackground">@color/white</item>
        <item name="android:textColorPrimary">@color/theme2</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>

        <!-- === ШРИФТЫ === -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>

        <!-- === ЭЛЕМЕНТЫ ИНТЕРФЕЙСА === -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/theme2</item>
        <item name="cardBackgroundColor">@color/theme1</item>
    </style>

    <!-- === БАЗОВЫЕ СТИЛИ КОМПОНЕНТОВ === -->

    <!-- Текст по умолчанию -->
    <style name="TextView.Default" parent="android:Widget.TextView">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/theme1</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Кнопка по умолчанию -->
    <style name="Button.Default" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">sans-serif</item>
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/theme2</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Заголовок экрана -->
    <style name="Text.Title">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/theme1</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Вторичный текст -->
    <style name="Text.Secondary">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Карточка (CardView) -->
    <style name="Card.Default" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/theme1</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="contentPadding">16dp</item>
    </style>

</resources>